@page
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - CarePride Academy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-badge">CP</div>
            <h1>CarePride</h1>
            <div class="login-subtitle">Academy Management</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 mb-3">@Model.ErrorMessage</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <label for="username">Username</label>
                <input type="text" id="username" name="Username" value="@Model.Username" autocomplete="username" autofocus />
            </div>
            <div class="form-row">
                <label for="password">Password</label>
                <input type="password" id="password" name="Password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn-login">Sign In</button>
        </form>
    </div>
</body>
</html>
