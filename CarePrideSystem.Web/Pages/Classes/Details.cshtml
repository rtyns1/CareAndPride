@page "{id:guid}"
@model CarePrideSystem.Web.Pages.Classes.DetailsModel
@{
    ViewData["Title"] = "Class Details";
    var subjectLookup = Model.Subjects.ToDictionary(s => s.Id, s => s.Name);
    var canUpload = User.IsInRole("Admin") || User.IsInRole("Teacher");
}
@if (Model.Class == null)
{
    <div class="alert alert-danger">Class not found.</div>
    <a class="btn btn-secondary" href="/Classes">Back</a>
}
else
{
    <div class="page-header">
        <div>
            <h1>@Model.Class.Name</h1>
            <p>Grade Level @Model.Class.GradeLevel</p>
        </div>
        <a class="btn btn-secondary" href="/Classes">Back to Classes</a>
    </div>

    <div class="panel" style="padding: 8px 24px; margin-bottom: 24px;">
        <div class="detail-row"><strong>Name</strong><span>@Model.Class.Name</span></div>
        <div class="detail-row"><strong>Grade Level</strong><span>@Model.Class.GradeLevel</span></div>
        <div class="detail-row"><strong>Capacity</strong><span>@Model.Class.Capacity</span></div>
        <div class="detail-row"><strong>Active</strong><span>@(Model.Class.IsActive ? "Yes" : "No")</span></div>
    </div>

    <h2 class="section-title">Teaching Materials for this Class</h2>
    <div class="panel" style="margin-bottom: 24px; padding: 20px;">
        <p class="cp-muted" style="margin-bottom:14px;">
            Exam papers, CATs, assignments, question banks, and teacher notes stored against this class and its subjects.
        </p>
        @if (Model.Assignments.Count == 0)
        {
            <div class="empty-state">
                <span class="icon">◯</span>
                <p>No materials uploaded yet.</p>
                <small>Teachers of this class can upload exam papers, question banks, and assignments here.</small>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Due</th><th>Type</th><th>Title</th><th>Subject</th><th>Max</th><th>File</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Assignments.OrderBy(a => a.DueDateUtc))
                    {
                        <tr>
                            <td>@a.DueDateUtc.ToString("yyyy-MM-dd")</td>
                            <td>@a.ExamType</td>
                            <td>@a.Title</td>
                            <td>@(subjectLookup.TryGetValue(a.SubjectId, out var sn) ? sn : "—")</td>
                            <td>@a.MaxScore.ToString("0.##")</td>
                            <td>
                                @if (a.HasFile)
                                {
                                    <a class="btn-link" href="/Assignments/Download/@a.Id">Download</a>
                                }
                                else
                                {
                                    <span class="cp-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (canUpload)
        {
            <a class="btn" href="/Assignments/Create?classId=@Model.Class.Id" style="margin-top:18px;">+ Upload Material</a>
        }
    </div>

    <h2 class="section-title">Students in this Class</h2>
    <div class="panel" style="margin-bottom: 24px;">
        @if (Model.Students.Count == 0)
        {
            <div class="empty-state"><span class="icon">◯</span><p>No students enrolled yet.</p></div>
        }
        else
        {
            <table>
                <thead><tr><th>Admission No</th><th>Name</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td>@s.AdmissionNumber</td>
                            <td>@s.FirstName @s.LastName</td>
                            <td><a class="btn-link" href="/Students/Details/@s.Id">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <h2 class="section-title">Teachers for this Class</h2>
    <div class="panel">
        @if (Model.ClassTeachers.Count == 0)
        {
            <div class="empty-state"><span class="icon">◯</span><p>No teachers assigned yet.</p></div>
        }
        else
        {
            <table>
                <thead><tr><th>Teacher ID</th><th>Type</th></tr></thead>
                <tbody>
                    @foreach (var ct in Model.ClassTeachers)
                    {
                        <tr>
                            <td><a class="btn-link" href="/Teachers/Details/@ct.TeacherId">@ct.TeacherId</a></td>
                            <td>@(ct.IsPrimary ? "Primary Class Teacher" : "Assistant")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
