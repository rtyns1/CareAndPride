@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "";
    string NavClass(string href) =>
        path.Equals(href, StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarePride Academy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (isAuth)
{
    <div class="app">
        <aside class="app-sidebar">
            <div class="app-brand">
                <span class="app-brand-mark">CP</span>
                <div class="app-brand-text">
                    <strong>CarePride</strong>
                    <small>Academy</small>
                </div>
            </div>
            <nav class="app-nav">
                <a class="@NavClass("/Index")" href="/Index">Dashboard</a>
                @if (User.IsInRole("Teacher"))
                {
                    <a class="@NavClass("/MyClasses")" href="/MyClasses">My Classes</a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Secretary") || User.IsInRole("Teacher"))
                {
                    <a class="@NavClass("/Students")" href="/Students">Students</a>
                    <a class="@NavClass("/Teachers")" href="/Teachers">Teachers</a>
                    <a class="@NavClass("/Classes")" href="/Classes">Classes</a>
                    <a class="@NavClass("/Subjects")" href="/Subjects">Subjects</a>
                }
                @if (User.IsInRole("Admin"))
                {                <a class="@NavClass("/MyProfile")" href="/MyProfile">My Profile</a>
                <a class="@NavClass("/Account/ChangePassword")" href="/Account/ChangePassword">Change Password</a>
                <div class="app-nav-section">Administration</div>
                    <a class="@NavClass("/Users")" href="/Users">Users</a>
                    <a class="@NavClass("/PendingApprovals")" href="/PendingApprovals">Pending Approvals</a>
                }
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-user">
                    <span class="app-user-name">@User.Identity?.Name</span>
                    <span class="app-user-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                </div>
                <form method="post" action="/Logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-logout">Sign out</button>
                </form>
            </header>
            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}
</body>
</html>


